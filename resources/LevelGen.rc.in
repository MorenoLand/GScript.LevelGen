1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/LevelGen.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @LEVELGEN_VERSION_COMMA@,0
 PRODUCTVERSION @LEVELGEN_VERSION_COMMA@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Stefan Knorr"
            VALUE "FileDescription", "Level Generator"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "LevelGen"
            VALUE "OriginalFilename", "LevelGen.exe"
            VALUE "ProductName", "Level Generator"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
